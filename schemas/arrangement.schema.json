{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Land of Mu Arrangement",
  "type": "object",
  "required": ["schema_version", "track_id", "title", "tempo_bpm", "meter", "notes"],
  "properties": {
    "schema_version": {"type": "string"},
    "track_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "tempo_bpm": {"type": "number", "exclusiveMinimum": 0, "maximum": 400},
    "meter": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 1, "maximum": 32},
        "denominator": {"type": "integer", "enum": [1, 2, 4, 8, 16, 32]}
      },
      "additionalProperties": false
    },
    "sample_rate": {"type": "integer", "enum": [22050, 44100, 48000, 88200, 96000]},
    "channels": {"type": "integer", "enum": [1, 2]},
    "bit_depth": {"type": "integer", "enum": [16, 24, 32]},
    "master_gain": {"type": "number", "minimum": 0, "maximum": 1},
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pitch", "start_beats", "duration_beats"],
        "properties": {
          "pitch": {"type": "integer", "minimum": 0, "maximum": 127},
          "start_beats": {"type": "number", "minimum": 0},
          "duration_beats": {"type": "number", "exclusiveMinimum": 0},
          "velocity": {"type": "integer", "minimum": 1, "maximum": 127},
          "track": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
